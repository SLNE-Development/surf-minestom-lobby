From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: twisti-dev <twisti@slne.dev>
Date: Mon, 3 Aug 2026 23:47:24 +0200
Subject: [PATCH] Make the runtime dependency manager work on Minestom

LuckPerms is embedded as a plain library on Minestom, so it is loaded by the
system class loader and its own classes are not relocated at build time. Both
facts broke the dependency manager, which was stubbed out with no-ops.

 - skip dependency relocation on Minestom, so downloaded jars keep the package
   names LuckPerms itself was compiled against
 - append downloaded jars to the system class loader via the instrumentation
   API, which requires the host application to install LuckPermsAgent
 - let embedders supply their own ClassPathAppender via the builder
 - use the real DependencyManagerImpl, with no global dependencies to download
   because those ship with the luckperms-minestom library

diff --git a/common/src/main/java/me/lucko/luckperms/common/dependencies/DependencyRegistry.java b/common/src/main/java/me/lucko/luckperms/common/dependencies/DependencyRegistry.java
index 088b25caae5246969dbdcccf242ebc1071b5537f..e68d39505a110b2e85794193cc0d5d500bb68ac6 100644
--- a/common/src/main/java/me/lucko/luckperms/common/dependencies/DependencyRegistry.java
+++ b/common/src/main/java/me/lucko/luckperms/common/dependencies/DependencyRegistry.java
@@ -64,6 +64,17 @@ public class DependencyRegistry {
             Platform.Type.BUKKIT, Platform.Type.BUNGEECORD, Platform.Type.SPONGE, Platform.Type.NUKKIT
     );
 
+    /**
+     * Platforms on which LuckPerms is shipped as a plain library instead of a shaded plugin jar.
+     *
+     * <p>Its own classes are not relocated at build time on these platforms, so it still refers to
+     * dependencies by their original package names - meaning downloaded dependencies must be left
+     * alone too.</p>
+     */
+    private static final Set<Platform.Type> DEPENDENCIES_NOT_RELOCATED = ImmutableSet.of(
+            Platform.Type.MINESTOM
+    );
+
     private final Platform.Type platformType;
 
     public DependencyRegistry(Platform.Type platformType) {
@@ -106,6 +117,13 @@ public class DependencyRegistry {
     }
 
     public void applyRelocationSettings(Dependency dependency, List<Relocation> relocations) {
+        // nothing is relocated on these platforms - clearing the rules means the dependency is used
+        // as-is, and also avoids pulling in the jar relocator machinery at all
+        if (DEPENDENCIES_NOT_RELOCATED.contains(this.platformType)) {
+            relocations.clear();
+            return;
+        }
+
         // support for LuckPerms legacy (bukkit 1.7.10)
         if (!RelocationHandler.DEPENDENCIES.contains(dependency) && isGsonRelocated()) {
             relocations.add(Relocation.of("guava", "com{}google{}common"));
